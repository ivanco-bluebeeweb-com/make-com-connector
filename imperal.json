{
  "manifest_schema_version": 3,
  "sdk_version": "5.9.22",
  "app_id": "make-com-connector",
  "version": "0.1.0",
  "name": "Make.com",
  "description": "Connect your own Make.com account to view and run your automation scenarios directly from Webbee -- see scenario status, run one on demand, and control activation, all via your own Make API token.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "make-com-connector:read",
    "make-com-connector:write"
  ],
  "tools": [
    {
      "name": "connect_make",
      "description": "Connect Make.com by saving your own API token, after checking it actually works. Create the token in Make: avatar (bottom-left) -> Profile -> API tab -> Add token. The account's zone (eu1/eu2/us1/us2) is auto-detected -- you don't need to know it.",
      "action_type": "write",
      "chain_callable": true,
      "effects": ["make.provider.connected"],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "api_token": {
            "default": "",
            "description": "Make.com API token -- create it in Make: avatar (bottom-left) -> Profile -> API tab -> Add token.",
            "title": "Api Token",
            "type": "string"
          }
        },
        "title": "ConnectMakeParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {"default": "", "title": "Id", "type": "string"},
          "title": {"default": "", "title": "Title", "type": "string"},
          "connected": {"default": false, "title": "Connected", "type": "boolean"},
          "detail": {"default": "", "title": "Detail", "type": "string"}
        },
        "title": "ProviderConnection",
        "type": "object",
        "x-sdl": "entity"
      },
      "event": "make-com-connector.connect_make",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "make_com_connector"
    },
    {
      "name": "disconnect_make",
      "description": "Disconnect Make.com: deletes the saved API token and zone. Existing scenarios in your Make account are never touched.",
      "action_type": "write",
      "chain_callable": true,
      "effects": ["make.provider.disconnected"],
      "id_projection": "",
      "params_schema": {
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {"default": "", "title": "Id", "type": "string"},
          "title": {"default": "", "title": "Title", "type": "string"},
          "connected": {"default": false, "title": "Connected", "type": "boolean"},
          "detail": {"default": "", "title": "Detail", "type": "string"}
        },
        "title": "ProviderConnection",
        "type": "object",
        "x-sdl": "entity"
      },
      "event": "make-com-connector.disconnect_make",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "make_com_connector"
    },
    {
      "name": "get_make_connection",
      "description": "Check whether Make.com is currently connected (does not reveal the saved token).",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {"default": "", "title": "Id", "type": "string"},
          "title": {"default": "", "title": "Title", "type": "string"},
          "connected": {"default": false, "title": "Connected", "type": "boolean"},
          "detail": {"default": "", "title": "Detail", "type": "string"}
        },
        "title": "ProviderConnection",
        "type": "object",
        "x-sdl": "entity"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "make_com_connector"
    },
    {
      "name": "list_make_teams",
      "description": "List the Make.com teams your connected account belongs to. Needed once to pick which team's scenarios to show -- Make requires a specific team (or organization) scope, it has no single global scenario list.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "MakeTeam": {
            "properties": {
              "id": {"default": "", "title": "Id", "type": "string"},
              "title": {"default": "", "title": "Title", "type": "string"},
              "organization_id": {"default": 0, "title": "Organization Id", "type": "integer"}
            },
            "title": "MakeTeam",
            "type": "object",
            "x-sdl": "entity"
          }
        },
        "properties": {
          "items": {"items": {"$ref": "#/$defs/MakeTeam"}, "title": "Items", "type": "array"},
          "total": {"default": 0, "title": "Total", "type": "integer"}
        },
        "title": "MakeTeamList",
        "type": "object",
        "x-sdl": "entity_list"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "make_com_connector"
    },
    {
      "name": "select_team",
      "description": "Pick which Make.com team's scenarios to show. Run list_make_teams first to see the available team ids. This is a standing choice -- it stays selected until changed again.",
      "action_type": "write",
      "chain_callable": true,
      "effects": ["make.team_scope.changed"],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "team_id": {
            "description": "Make team id to scope scenario listing to (see list_make_teams).",
            "title": "Team Id",
            "type": "integer"
          }
        },
        "required": ["team_id"],
        "title": "SelectTeamParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {"default": "", "title": "Id", "type": "string"},
          "title": {"default": "", "title": "Title", "type": "string"},
          "connected": {"default": false, "title": "Connected", "type": "boolean"},
          "detail": {"default": "", "title": "Detail", "type": "string"}
        },
        "title": "ProviderConnection",
        "type": "object",
        "x-sdl": "entity"
      },
      "event": "make-com-connector.select_team",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "make_com_connector"
    },
    {
      "name": "list_scenarios",
      "description": "List your Make.com scenarios for the selected team -- name, active/paused/invalid state, and last edit time. Run connect_make and select_team first if you haven't yet.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "limit": {"default": 50, "maximum": 200, "minimum": 1, "title": "Limit", "type": "integer"},
          "offset": {"default": 0, "minimum": 0, "title": "Offset", "type": "integer"}
        },
        "title": "ListScenariosParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "MakeScenario": {
            "properties": {
              "id": {"default": "", "title": "Id", "type": "string"},
              "title": {"default": "", "title": "Title", "type": "string"},
              "scenario_id": {"default": 0, "title": "Scenario Id", "type": "integer"},
              "team_id": {"default": 0, "title": "Team Id", "type": "integer"},
              "is_active": {"default": false, "title": "Is Active", "type": "boolean"},
              "is_paused": {"default": false, "title": "Is Paused", "type": "boolean"},
              "is_invalid": {"default": false, "title": "Is Invalid", "type": "boolean"},
              "folder_id": {"default": null, "title": "Folder Id", "type": "integer"},
              "last_edit": {"default": "", "title": "Last Edit", "type": "string"},
              "scheduling_type": {"default": "", "title": "Scheduling Type", "type": "string"}
            },
            "title": "MakeScenario",
            "type": "object",
            "x-sdl": "entity"
          }
        },
        "properties": {
          "items": {"items": {"$ref": "#/$defs/MakeScenario"}, "title": "Items", "type": "array"},
          "total": {"default": 0, "title": "Total", "type": "integer"}
        },
        "title": "MakeScenarioList",
        "type": "object",
        "x-sdl": "entity_list"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "make_com_connector"
    },
    {
      "name": "run_scenario",
      "description": "Run one of your Make.com scenarios right now, by scenario_id (see list_scenarios). This executes the scenario's real actions in Make immediately -- sending emails, writing to connected apps, etc. There is no dry-run or undo, so this always asks for confirm=true first.",
      "action_type": "write",
      "chain_callable": true,
      "effects": ["make.scenario.run"],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "scenario_id": {
            "description": "Make scenario id to run now (see list_scenarios).",
            "title": "Scenario Id",
            "type": "integer"
          },
          "confirm": {
            "default": false,
            "description": "Must be true. Running a scenario executes its real actions in Make right now (sending emails, writing to connected apps, etc.) -- there is no dry-run or undo.",
            "title": "Confirm",
            "type": "boolean"
          }
        },
        "required": ["scenario_id"],
        "title": "RunScenarioParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {"default": "", "title": "Id", "type": "string"},
          "title": {"default": "", "title": "Title", "type": "string"},
          "scenario_id": {"default": 0, "title": "Scenario Id", "type": "integer"},
          "execution_id": {"default": "", "title": "Execution Id", "type": "string"},
          "status": {"default": "", "title": "Status", "type": "string"}
        },
        "title": "ScenarioRunResult",
        "type": "object",
        "x-sdl": "entity"
      },
      "event": "make-com-connector.run_scenario",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "make_com_connector"
    },
    {
      "name": "set_scenario_active",
      "description": "Activate (turn on/schedule) or deactivate (pause) a Make.com scenario by scenario_id (see list_scenarios). Reversible -- flip it back any time -- so unlike run_scenario this needs no confirmation.",
      "action_type": "write",
      "chain_callable": true,
      "effects": ["make.scenario.state_changed"],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "scenario_id": {
            "description": "Make scenario id to activate/deactivate (see list_scenarios).",
            "title": "Scenario Id",
            "type": "integer"
          },
          "active": {
            "description": "True to activate (schedule/turn on) the scenario, False to deactivate (pause) it.",
            "title": "Active",
            "type": "boolean"
          }
        },
        "required": ["scenario_id", "active"],
        "title": "SetScenarioActiveParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {"default": "", "title": "Id", "type": "string"},
          "title": {"default": "", "title": "Title", "type": "string"},
          "scenario_id": {"default": 0, "title": "Scenario Id", "type": "integer"},
          "is_active": {"default": false, "title": "Is Active", "type": "boolean"}
        },
        "title": "ScenarioStateResult",
        "type": "object",
        "x-sdl": "entity"
      },
      "event": "make-com-connector.set_scenario_active",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "make_com_connector"
    }
  ],
  "signals": [],
  "schedules": [],
  "required_scopes": [],
  "icon_size_bytes": 425,
  "webhooks": [],
  "lifecycle": {
    "on_install": false
  },
  "lifecycle_hooks": {},
  "secrets": [
    {
      "name": "make_api_token",
      "description": "Your own Make.com API token, from Make: avatar (bottom-left) -> Profile -> API tab -> Add token.",
      "required": false,
      "write_mode": "both",
      "max_bytes": 512,
      "scope": "app"
    },
    {
      "name": "make_zone",
      "description": "Auto-detected Make.com account zone (eu1/eu2/us1/us2) -- set automatically by connect_make, not entered manually.",
      "required": false,
      "write_mode": "both",
      "max_bytes": 64,
      "scope": "app"
    }
  ],
  "panels": [
    {
      "panel_id": "make_connect",
      "slot": "left",
      "title": "Make.com",
      "tree": {},
      "icon": "🧩",
      "refresh": "manual",
      "center_overlay": false
    },
    {
      "panel_id": "make_connect_help",
      "slot": "center",
      "title": "How to get a Make API token",
      "tree": {},
      "icon": "",
      "refresh": "manual",
      "center_overlay": true
    }
  ]
}
